{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loomer",
  "version": "0.1.0",
  "identifier": "com.loomerbrowser.loomer",
  "build": {
    "beforeDevCommand": "pnpm --filter @loomer/desktop-ui start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm --filter @loomer/desktop-ui build",
    "frontendDist": "../../dist/packages/desktop-ui/browser"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Loomer",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.local; img-src 'self' data: https: http:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": [
      "../../assets/icon.png",
      "../../assets/icon.ico"
    ]
  }
}